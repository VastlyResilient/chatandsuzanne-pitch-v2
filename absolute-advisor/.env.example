# 1) Paste your Anthropic API key here (get one at https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# 2) Optional: require a passcode to open the app. Strongly recommended when hosted in the cloud.
APP_PASSWORD=

# Optional tuning (the defaults are good)
# MODEL=claude-opus-5
# EFFORT=high          # low | medium | high | xhigh | max  (higher = deeper thinking, slower)
# PORT=3000
# DATA_DIR=./data      # where the roster and memory notes are saved
